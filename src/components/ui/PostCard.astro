---
interface Props {
  title: string;
  slug: string;
  excerpt?: string;
  pubDate: Date;
}

const { title, slug, excerpt, pubDate } = Astro.props;

const formatDate = (d: Date) =>
  d.toLocaleDateString(undefined, { year: "numeric", month: "short", day: "2-digit" });
---

<a
  href={`/content/${slug}`}
  class="group block h-full rounded-xl bg-white/5 hover:bg-white/10 transition-colors duration-300 p-6 focus:outline-none focus:ring-2 focus:ring-zinc-400/40"
>
  <div class="flex items-start justify-between gap-4">
    <h2 class="text-lg md:text-xl font-semibold text-white group-hover:text-white/90">
      {title}
    </h2>
    <span class="shrink-0 text-xs text-zinc-400 mt-1">{formatDate(pubDate)}</span>
  </div>
  {excerpt && (
    <p class="mt-2 text-sm text-zinc-400 leading-relaxed">{excerpt}</p>
  )}
  <div class="mt-4 text-xs text-zinc-400 opacity-80 group-hover:opacity-100 transition-opacity">
    Read &rarr;
  </div>
</a>
