---
/**
 * Same box treatment as PostCard on /content, but laid out for logs: the
 * number leads the title, and the date sits underneath rather than off to
 * the right.
 */
interface Props {
  number: number;
  title: string;
  excerpt: string;
  date: Date;
}

const { number, title, excerpt, date } = Astro.props;

const formatDate = (d: Date) =>
  d.toLocaleDateString(undefined, { year: "numeric", month: "short", day: "2-digit" });
---

<a
  href={`/logs/${number}`}
  class="group block h-full rounded-xl bg-white/5 hover:bg-white/10 transition-colors duration-300 p-6 focus:outline-none focus:ring-2 focus:ring-zinc-400/40"
>
  <h2 class="text-lg md:text-xl font-semibold text-white group-hover:text-white/90">
    <span class="text-zinc-500 font-normal">#{number}</span> {title}
  </h2>
  <div class="mt-1 text-xs text-zinc-400">{formatDate(date)}</div>
  {excerpt && (
    <p class="mt-3 text-sm text-zinc-400 leading-relaxed">{excerpt}</p>
  )}
</a>
