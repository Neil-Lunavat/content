---
interface Props {
  toc: { id: string; text: string }[];
}

const { toc } = Astro.props;
---

<nav
  class="hidden lg:block bg-black/30 rounded-xl p-4 border border-zinc-800"
  aria-label="Table of contents"
>
  <h4 class="text-white font-semibold mb-3 text-sm uppercase tracking-wide">
    Table of Contents
  </h4>
  <ul class="space-y-2">
    {toc.map((item) => (
      <li>
        <a
          href={`#${item.id}`}
          class="text-zinc-300 hover:text-purple-400 transition-colors block px-2 py-1 rounded text-sm"
        >
          {item.text}
        </a>
      </li>
    ))}
  </ul>
</nav>
