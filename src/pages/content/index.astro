---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/ui/PostCard.astro";

const blogs: { title: string; slug: string; excerpt: string; pubDate: Date }[] = [];

const guides = [
  {
    title: "The Mindset Revolution",
    slug: "the-mindset-revolution",
    excerpt: "A perspective shift that turns 'hard' into 'unfamiliar' — and familiar into mastered.",
    pubDate: new Date("2025-04-30T00:00:00.000Z"),
  },
  {
    title: "The Cognitive Framework",
    slug: "the-cognitive-framework",
    excerpt: "A complete framework for managing complexity, cognitive load, and accelerated learning with the help of AI.",
    pubDate: new Date("2025-05-15T00:00:00.000Z"),
  },
];

const conversations = [
  {
    title: "Vol. 1 — The Laptop Fix",
    slug: "3am-vol1-the-laptop-fix",
    excerpt: "Started with a malfunctioning HP laptop at 2:48 AM. Ended somewhere between AI economics, quant finance, and who actually benefits from all this. Unfiltered.",
    pubDate: new Date("2026-03-23T00:00:00.000Z"),
  },
  {
    title: "Vol. 2 — The Gear Shift",
    slug: "3am-vol2-the-gear-shift",
    excerpt: "A bike gear analogy turned into a full framework for skill acquisition — logarithmic curves, boredom as a signal, and why grinding the wrong coefficient is the most common plateau.",
    pubDate: new Date("2026-03-25T00:00:00.000Z"),
  },
];

const articles = [
  {
    title: "A letter to Artificial Intelligence",
    slug: "a-letter-to-artificial-intelligence",
    excerpt: "A poem about why we build machines that think — and what we're really reaching for.",
    pubDate: new Date("2026-07-29T00:00:00.000Z"),
  },
  {
    title: "A unique perspective on Neuromancer by William Gibson",
    slug: "you-are-not-the-main-character",
    excerpt: "Neuromancer's quiet truth: the systems around you don't need your consent. They just need your dependency.",
    pubDate: new Date("2026-03-08T00:00:00.000Z"),
  },
];
---

<BaseLayout
  title="Content | Neil Lunavat"
  description="Essays, articles, and reflections on AI, learning, technology, and the human condition."
>
  <main class="max-w-5xl mx-auto px-6 md:px-8 pt-28 pb-16">

    <!-- Blogs -->
    {blogs.length > 0 && (
      <section class="mb-16">
        <div class="mb-8">
          <h1 class="text-4xl md:text-5xl mb-2 text-white" style="font-family: var(--font-serif);">Blogs</h1>
          <p class="text-zinc-400 max-w-3xl">
            Personal writing on technology, ideas, and everything in between.
          </p>
        </div>

        <ul class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
          {blogs.map((p) => (
            <li><PostCard {...p} /></li>
          ))}
        </ul>
      </section>
    )}

    <!-- Guides -->
    <section class="mb-16">
      <div class="mb-8">
        <h1 class="text-4xl md:text-5xl mb-2 text-white" style="font-family: var(--font-serif);">Guides</h1>
        <p class="text-zinc-400 max-w-3xl">
          Frameworks on learning, cognition, and building better mental models in the age of AI.
        </p>
      </div>

      <ul class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
        {guides.map((p) => (
          <li><PostCard {...p} /></li>
        ))}
      </ul>
    </section>

    <!-- 3 AM Conversations with AI -->
    <section class="mb-16">
      <div class="mb-8">
        <h1 class="text-4xl md:text-5xl mb-2 text-white" style="font-family: var(--font-serif);">3 AM Conversations with AI</h1>
        <p class="text-zinc-400 max-w-3xl">
          Raw, unfiltered conversations that went somewhere unexpected.
        </p>
      </div>

      <ul class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
        {conversations.map((p) => (
          <li><PostCard {...p} /></li>
        ))}
      </ul>
    </section>

    <!-- Articles -->
    <section>
      <div class="mb-8">
        <h2 class="text-4xl md:text-5xl mb-2 text-white" style="font-family: var(--font-serif);">Articles</h2>
        <p class="text-zinc-400 max-w-3xl">
          Reflections on books, culture, and the ideas worth sitting with.
        </p>
      </div>

      <ul class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
        {articles.map((p) => (
          <li><PostCard {...p} /></li>
        ))}
      </ul>
    </section>

  </main>
</BaseLayout>
