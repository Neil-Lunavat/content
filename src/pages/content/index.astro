---
import BaseLayout from "../../layouts/BaseLayout.astro";

const essays = [
  {
    title: "The Mindset Revolution",
    slug: "the-mindset-revolution",
    excerpt: "A perspective shift that turns 'hard' into 'unfamiliar' — and familiar into mastered.",
    pubDate: new Date("2025-04-30T00:00:00.000Z"),
    featured: true,
  },
  {
    title: "The Cognitive Framework",
    slug: "the-cognitive-framework",
    excerpt: "A complete framework for managing complexity, cognitive load, and accelerated learning with the help of AI.",
    pubDate: new Date("2025-05-15T00:00:00.000Z"),
    featured: false,
  },
];

const articles = [
  {
    title: "A unique perspective on Neuromancer by William Gibson",
    slug: "you-are-not-the-main-character",
    excerpt: "Neuromancer's quiet truth: the systems around you don't need your consent. They just need your dependency.",
    pubDate: new Date("2026-03-08T00:00:00.000Z"),
    featured: true,
  },
];

const formatDate = (d: Date) =>
  d.toLocaleDateString(undefined, { year: "numeric", month: "short", day: "2-digit" });
---

<BaseLayout
  title="Content | Neil Lunavat"
  description="Essays, articles, and reflections on AI, learning, technology, and the human condition."
>
  <main class="max-w-5xl mx-auto px-6 md:px-8 pt-28 pb-16">

    <!-- Essays -->
    <section class="mb-16">
      <div class="mb-8">
        <h1 class="text-4xl md:text-5xl mb-2 text-white" style="font-family: var(--font-serif);">Essays</h1>
        <p class="text-zinc-400 max-w-3xl">
          Frameworks on learning, cognition, and building better mental models in the age of AI.
        </p>
      </div>

      <ul class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
        {essays.map((p) => (
          <li>
            {p.featured ? (
              <div
                class="relative rounded-2xl p-[1.5px]"
                style="background: linear-gradient(90deg, #4C1D95, #7C3AED, #1E40AF);"
              >
                <a
                  href={`/content/${p.slug}`}
                  class="group relative block h-full rounded-2xl bg-black hover:bg-white/10 transition-colors duration-300 p-6 focus:outline-none focus:ring-2 focus:ring-zinc-400/40"
                >
                  <div class="flex items-start justify-between gap-4">
                    <h2 class="text-lg md:text-xl font-semibold text-white group-hover:text-white/90">
                      {p.title}
                    </h2>
                    <span class="shrink-0 text-xs text-zinc-400 mt-1">{formatDate(p.pubDate)}</span>
                  </div>
                  {p.excerpt && (
                    <p class="mt-2 text-sm text-zinc-400 leading-relaxed">{p.excerpt}</p>
                  )}
                  <div class="mt-4 text-xs text-zinc-400 opacity-80 group-hover:opacity-100 transition-opacity">
                    Read &rarr;
                  </div>
                  <div class="pointer-events-none absolute inset-0 z-10 rounded-2xl bg-black/60 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                    <span class="px-3 py-1 rounded-full text-xs md:text-sm font-semibold uppercase tracking-wide text-white/95 bg-black/40 backdrop-blur-sm">
                      Start here
                    </span>
                  </div>
                </a>
              </div>
            ) : (
              <a
                href={`/content/${p.slug}`}
                class="group block h-full rounded-xl border border-white/10 bg-white/5 hover:bg-white/10 transition-colors duration-300 p-6 focus:outline-none focus:ring-2 focus:ring-zinc-400/40"
              >
                <div class="flex items-start justify-between gap-4">
                  <h2 class="text-lg md:text-xl font-semibold text-white group-hover:text-white/90">
                    {p.title}
                  </h2>
                  <span class="shrink-0 text-xs text-zinc-400 mt-1">{formatDate(p.pubDate)}</span>
                </div>
                {p.excerpt && (
                  <p class="mt-2 text-sm text-zinc-400 leading-relaxed">{p.excerpt}</p>
                )}
                <div class="mt-4 text-xs text-zinc-400 opacity-80 group-hover:opacity-100 transition-opacity">
                  Read &rarr;
                </div>
              </a>
            )}
          </li>
        ))}
      </ul>
    </section>

    <!-- Articles -->
    <section>
      <div class="mb-8">
        <h2 class="text-4xl md:text-5xl mb-2 text-white" style="font-family: var(--font-serif);">Articles</h2>
        <p class="text-zinc-400 max-w-3xl">
          Reflections on books, culture, and the ideas worth sitting with.
        </p>
      </div>

      <ul class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
        {articles.map((p) => (
          <li>
            {p.featured ? (
              <div
                class="relative rounded-2xl p-[1.5px]"
                style="background: linear-gradient(90deg, #4C1D95, #7C3AED, #1E40AF);"
              >
                <a
                  href={`/content/${p.slug}`}
                  class="group relative block h-full rounded-2xl bg-black hover:bg-white/10 transition-colors duration-300 p-6 focus:outline-none focus:ring-2 focus:ring-zinc-400/40"
                >
                  <div class="flex items-start justify-between gap-4">
                    <h2 class="text-lg md:text-xl font-semibold text-white group-hover:text-white/90">
                      {p.title}
                    </h2>
                    <span class="shrink-0 text-xs text-zinc-400 mt-1">{formatDate(p.pubDate)}</span>
                  </div>
                  {p.excerpt && (
                    <p class="mt-2 text-sm text-zinc-400 leading-relaxed">{p.excerpt}</p>
                  )}
                  <div class="mt-4 text-xs text-zinc-400 opacity-80 group-hover:opacity-100 transition-opacity">
                    Read &rarr;
                  </div>
                  <div class="pointer-events-none absolute inset-0 z-10 rounded-2xl bg-black/60 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                    <span class="px-3 py-1 rounded-full text-xs md:text-sm font-semibold uppercase tracking-wide text-white/95 bg-black/40 backdrop-blur-sm">
                      literary analysis
                    </span>
                  </div>
                </a>
              </div>
            ) : (
              <a
                href={`/content/${p.slug}`}
                class="group block h-full rounded-xl border border-white/10 bg-white/5 hover:bg-white/10 transition-colors duration-300 p-6 focus:outline-none focus:ring-2 focus:ring-zinc-400/40"
              >
                <div class="flex items-start justify-between gap-4">
                  <h2 class="text-lg md:text-xl font-semibold text-white group-hover:text-white/90">
                    {p.title}
                  </h2>
                  <span class="shrink-0 text-xs text-zinc-400 mt-1">{formatDate(p.pubDate)}</span>
                </div>
                {p.excerpt && (
                  <p class="mt-2 text-sm text-zinc-400 leading-relaxed">{p.excerpt}</p>
                )}
                <div class="mt-4 text-xs text-zinc-400 opacity-80 group-hover:opacity-100 transition-opacity">
                  Read &rarr;
                </div>
              </a>
            )}
          </li>
        ))}
      </ul>
    </section>

  </main>
</BaseLayout>
