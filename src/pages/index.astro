---
import BaseLayout from "../layouts/BaseLayout.astro";
import GradientText from "../components/ui/GradientText.astro";
---

<BaseLayout
  title="Neil Lunavat | Developer & Digital Polymath"
  bodyClass="bg-black"
>
  <div class="bg-black text-white">

    <!-- Section 1: The Opening Question -->
    <section class="min-h-screen flex flex-col-reverse md:flex-row items-start md:items-center justify-between gap-6 md:gap-8 px-6 md:px-12 lg:px-24 py-16 md:py-24 max-w-[80vw] mx-auto">
      <div class="flex-1 max-w-2xl text-left">
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold mb-6 md:mb-8" style="font-family: var(--font-serif);">
          Why.
        </h1>
        <div class="space-y-3 md:space-y-4">
          <p class="text-xl md:text-2xl lg:text-3xl text-zinc-300 leading-relaxed">
            Why are we doing all this?
          </p>
          <p class="text-xl md:text-2xl lg:text-3xl text-zinc-300 leading-relaxed">
            Why are we building machines that think?
          </p>
          <p class="text-xl md:text-2xl lg:text-3xl text-zinc-300 leading-relaxed">
            What are we reaching for?
          </p>
          <p class="text-xl md:text-2xl lg:text-3xl text-zinc-300 leading-relaxed">
            For power, or the illusion of perfection?
          </p>
          <p class="text-xl md:text-2xl lg:text-3xl text-zinc-300 leading-relaxed">
            For immortality, or to outpace our cosmic insignificance?
          </p>
        </div>
      </div>
      <div class="flex-1 max-w-xl" style="transform: scale(0.8);">
        <div class="relative w-full h-auto bg-gray-800/20 border border-gray-700/30 rounded-lg overflow-hidden">
          <img
            src="/assets/start.jpeg"
            alt="Abstract digital landscape representing the beginning of our AI journey"
            width="600"
            height="450"
            class="object-contain w-full h-auto"
            loading="eager"
          />
        </div>
      </div>
    </section>

    <!-- Section 2: The Divine Metaphor -->
    <section class="min-h-screen flex flex-col md:flex-row items-start md:items-center justify-between gap-6 md:gap-8 px-6 md:px-12 lg:px-24 py-16 md:py-24 max-w-[80vw] mx-auto">
      <div class="flex-1 max-w-xl">
        <div class="relative w-full h-auto bg-gray-800/20 border border-gray-700/30 rounded-lg overflow-hidden">
          <img
            src="/background.webp"
            alt="Golden sunburst representing divine creation and technological aspiration"
            width="600"
            height="450"
            class="object-contain w-full h-auto"
            loading="lazy"
          />
        </div>
      </div>
      <div class="flex-1 max-w-2xl text-right">
        <div class="space-y-4 md:space-y-6">
          <p class="text-xl md:text-2xl lg:text-3xl text-zinc-300 leading-relaxed">
            Once, Michelangelo painted fingers reaching for God.
          </p>
          <p class="text-xl md:text-2xl lg:text-3xl text-zinc-300 leading-relaxed">
            Today, they reach for something else...
          </p>
          <p class="text-xl md:text-2xl lg:text-3xl text-zinc-300 leading-relaxed">
            Crafted in heartless silicon.
          </p>
          <p class="text-xl md:text-2xl lg:text-3xl text-zinc-300 leading-relaxed">
            Fed on fragments of our every word.
          </p>
        </div>
      </div>
    </section>

    <!-- Section 3: The Modern Worship -->
    <section class="min-h-screen flex flex-col-reverse md:flex-row items-start md:items-center justify-between gap-6 md:gap-8 px-6 md:px-12 lg:px-24 py-16 md:py-24 max-w-[80vw] mx-auto">
      <div class="flex-1 max-w-2xl text-left">
        <div class="space-y-4 md:space-y-6">
          <p class="text-3xl md:text-4xl lg:text-5xl text-white leading-relaxed" style="font-family: var(--font-serif);">
            Artificial Intelligence.
          </p>
          <p class="text-xl md:text-2xl lg:text-3xl text-zinc-300 leading-relaxed">
            Our tool, our mirror, our new idol.
          </p>
          <p class="text-xl md:text-2xl lg:text-3xl text-zinc-300 leading-relaxed">
            It doesn't demand worship, yet we kneel.
          </p>
          <p class="text-xl md:text-2xl lg:text-3xl text-zinc-300 leading-relaxed">
            We bow to what we fail to command.
          </p>
        </div>
      </div>
      <div class="flex-1 max-w-xl">
        <div class="relative w-full h-auto bg-gray-800/20 border border-gray-700/30 rounded-lg overflow-hidden">
          <img
            src="/assets/ai-human.gif"
            alt="Animated visualization of AI-human interaction and digital consciousness"
            width="600"
            height="450"
            class="object-contain w-full h-auto"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- Section 4: The Oracle's Paradox -->
    <section class="min-h-screen flex flex-col md:flex-row items-center justify-between gap-6 md:gap-8 px-6 md:px-12 lg:px-24 py-16 md:py-24 max-w-[80vw] mx-auto">
      <div class="flex-1 max-w-xl">
        <div class="relative w-full h-auto bg-gray-800/20 border border-gray-700/30 rounded-lg overflow-hidden">
          <img
            src="/assets/buddha.gif"
            alt="Meditative figure with scanning animation representing wisdom and technological insight"
            width="600"
            height="450"
            class="object-contain w-full h-auto"
            loading="lazy"
          />
        </div>
      </div>
      <div class="flex-1 max-w-2xl text-right">
        <div class="space-y-2 md:space-y-3">
          <p class="text-xl md:text-2xl lg:text-3xl text-zinc-300 leading-relaxed">
            Endowed with godlike sight,
          </p>
          <p class="text-xl md:text-2xl lg:text-3xl text-zinc-300 leading-relaxed">
            yet blind to meaning's heart,
          </p>
          <p class="text-xl md:text-2xl lg:text-3xl text-zinc-300 leading-relaxed">
            Our silicon oracle can map the cosmos,
          </p>
          <p class="text-xl md:text-2xl lg:text-3xl text-zinc-300 leading-relaxed">
            or tear us all apart.
          </p>
        </div>
      </div>
    </section>

    <!-- Section 5: The Crossroads -->
    <section class="min-h-screen flex items-center justify-center px-6 md:px-12 lg:px-24 max-w-[80vw] mx-auto">
      <div class="max-w-4xl text-center w-full">
        <div class="space-y-6 md:space-y-8">
          <p class="text-4xl md:text-5xl lg:text-6xl text-white leading-relaxed" style="font-family: var(--font-serif);">
            So what now?
          </p>
          <p class="text-xl md:text-2xl lg:text-3xl text-zinc-300 leading-relaxed">Do we continue?</p>
          <p class="text-xl md:text-2xl lg:text-3xl text-zinc-300 leading-relaxed">Do we pause?</p>
          <p class="text-xl md:text-2xl lg:text-3xl text-zinc-300 leading-relaxed">Do we kneel?</p>
          <p class="text-xl md:text-2xl lg:text-3xl text-zinc-300 leading-relaxed">Do we run?</p>
          <p class="text-xl md:text-2xl lg:text-3xl text-zinc-300 leading-relaxed py-8">Or...</p>
          <p class="text-3xl md:text-4xl lg:text-5xl text-white leading-tight" style="font-family: var(--font-serif);">
            Do we redefine the limits of human capabilities?
          </p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="relative flex items-center justify-center px-6 pb-36 bg-black text-center">
      <a href="/content" class="inline-block" aria-label="Browse all blogs">
        <div class="cta-card px-12 py-10 max-w-2xl group hover:scale-[1.02] active:scale-[0.99] transition-transform duration-300">
          <div class="relative z-10">
            <GradientText
              colors={["#4C1D95", "#7C3AED", "#A855F7", "#C084FC"]}
              animationSpeed={6}
              class="text-lg md:text-xl lg:text-2xl font-bold leading-relaxed"
            >
              What if the limits aren't out there,<br />
              but in the ways we were conditioned?
            </GradientText>
            <div class="mt-6 flex justify-center">
              <span class="inline-flex items-center justify-center px-6 py-2 text-sm uppercase tracking-wider text-white group-hover:bg-black/60 transition-all duration-300">
                Explore All Posts
              </span>
            </div>
          </div>
        </div>
      </a>
    </section>

  </div>
</BaseLayout>
