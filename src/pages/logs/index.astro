---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LogCard from "../../components/ui/LogCard.astro";
import { getEnv, requireEnv } from "../../lib/env";
import { readLogs, excerptOf, type LogEntry } from "../../lib/sheets";

// Read from the sheet on every request so a new log shows up without a rebuild.
export const prerender = false;

let logs: LogEntry[] = [];
let error: string | null = null;

try {
  const env = getEnv(Astro.locals);
  requireEnv(env);
  logs = await readLogs(env);
} catch (err) {
  error = (err as Error).message;
}

// Newest first.
const ordered = [...logs].reverse();
---

<BaseLayout
  title="Logs | Neil Lunavat"
  description="My life, zoomed in and zoomed out."
>
  <main class="max-w-5xl mx-auto px-6 md:px-8 pt-28 pb-16">

    <div class="mb-8">
      <h1 class="text-4xl md:text-5xl mb-2 text-white" style="font-family: var(--font-serif);">Logs</h1>
      <p class="text-zinc-400 max-w-3xl">
        My life, zoomed in and zoomed out.
      </p>
    </div>

    {error && (
      <div class="rounded-xl border border-red-900/60 bg-red-950/30 p-6 text-sm text-red-200">
        <p class="font-semibold mb-2">Couldn't load the logs.</p>
        <p class="text-red-300/80 leading-relaxed">{error}</p>
      </div>
    )}

    {!error && ordered.length === 0 && (
      <p class="text-zinc-400">No logs yet.</p>
    )}

    {!error && ordered.length > 0 && (
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
        {ordered.map((log) => (
          <li>
            <LogCard
              number={log.number}
              title={log.title}
              excerpt={excerptOf(log.body)}
              date={log.date}
            />
          </li>
        ))}
      </ul>
    )}

  </main>
</BaseLayout>
